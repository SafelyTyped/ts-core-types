{
    "entryPoints": [ "src/index.ts" ],
    "tsconfig": "tsconfig-esm.json",
    "out": "reference-docs",
    "categorizeByGroup": true,
    "externalPattern": [
        "**/_fixtures/**",
        "**/*.spec.*"
    ],
    "excludeInternal": true,
    "excludeReferences": true,

    "entryPointStrategy": "resolve",
    "name": "SafelyTyped core types"
}
